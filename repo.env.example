# Shared Vivi Dynamics workflow configuration. Copy to local repo.env.
# Authentication uses already configured, authorized gh access.
# Do not add login commands, secrets, or application credentials here.
VIVI_REPO=ViviDynamics/scrutare
VIVI_DEFAULT_BRANCH=main
VIVI_MERGE_FLAGS="--squash --delete-branch"
VIVI_CI_WORKFLOW=ci.yml
VIVI_HOUSE_RULES_FILE=CONTRIBUTING.md
VIVI_TEST_COMMANDS_FILE=.agents/test-commands.md
VIVI_BRANCH_PATTERN={issue}-{slug}
VIVI_PROJECT_NUMBER=17
VIVI_PROJECT_OWNER=ViviDynamics
# Per-person assignment belongs in local repo.env; unset uses the gh identity.
VIVI_ASSIGNEE=
