+def test_actual_context_discovery_guidance_and_batched_reads_preserve_rails(
+    capture, tmp_path, installed,
+):
+    from test_repository_context import contextual
+
+    config, _ = contextual(capture, max_file_bytes=50)
+    document = config.to_dict()
+    document["personas"] = ["senior-dev"]
+    document["budgets"] = {"per_persona_tokens": 100, "review_max_tokens": 100}
+    config = parse_config(json.dumps(document))
+    for name in ("config.yaml", "config.json"):
+        (capture / name).write_text(json.dumps(config.to_dict()))
+    inputs = prepare_review_inputs(capture, config)
+    manifests = ["diff.patch", "files.json", "context.json", "repository-context.json"]
+    entries = load(inputs.root / "repository-context.json")["entries"]
+    sources = [entry["artifact"] for entry in entries
+               if entry["path"] == "src/caller.py" and entry["status"] == "captured"]
+    assert len(sources) == 2
+
+    def batch(requests):
+        replies = [tool(name, args, call_id=identity) for identity, name, args in requests]
+        return {
+            "content": [block for reply in replies for block in reply["content"]],
+            "tool_calls": [call for reply in replies for call in reply["tool_calls"]],
+            "stop_reason": "tool_use",
+            "usage": {"input": 2, "output": 3, "cache_read": 5, "cache_write": 8},
+        }
+
+    scenario = {"replies": [
+        batch([(path, "read", {"path": path}) for path in manifests]),
+        batch([(path, "read", {"path": path}) for path in sources]),
+        batch([
+            ("escape", "read", {"path": str(capture / "metadata.json")}),
+            ("write", "write", {"path": "diff.patch", "content": "changed"}),
+            ("execute", "bash", {"command": "gh api user"}),
+        ]),
+        text({"findings": []}, usage={"input": 2, "output": 3,
+                                     "cache_read": 5, "cache_write": 8}),
+    ]}
+    descriptor = prepare_persona_inputs(inputs, config.personas)[0]
+    ledger = ReviewBudgetLedger(("senior-dev",), config.budgets)
+    lease = ledger.admit("senior-dev", "session")
+    directory = create_attempt_directory(capture, "senior-dev", prepared_root=inputs.root)
+    runtime = offline_runtime(tmp_path, installed, default=scenario)
+    before = {p: p.read_bytes() for p in capture.rglob("*") if p.is_file()}
+
+    async def execute():
+        capability = await inspect_nare_runtime(runtime)
+        return await run_persona_session(
+            descriptor, config.models.default, lease, ledger=ledger,
+            artifact_directory=directory, runtime=runtime, capability=capability,
+        )
+
+    outcome = asyncio.run(execute())
+    observed = observations(outcome)
+    # Check the installed CLI's actual task, not only the Python prompt property.
+    prompt = observed["selection"]["prompt"]
+    assert ("batch reads of diff.patch, files.json, context.json, "
+            "and repository-context.json") in prompt
+    assert "same native turn" in prompt
+    assert "using these read-root-relative names" in prompt
+    assert "manifest artifact names as read-root-relative paths" in prompt
+    assert "finding locations still use logical repository paths" in prompt
+    assert "Avoid unnecessary rereads" in prompt
+    assert outcome.status == "complete" and outcome.output_available
+    assert outcome.findings == () and outcome.accounting_complete and ledger.accounting_complete
+    assert outcome.usage == ledger.usage == TokenUsage(8, 12, 20, 32)
+    assert outcome.overshoot_tokens == 0 and not ledger.exhausted
+    assert len(observed["calls"]) == 4
+    assert all([item["name"] for item in call["tools"]] == ["read"]
+               for call in observed["calls"])
+    session = load(directory / "session.json")
+    assert session["policy"] == {"tools": ["read"], "root": str(inputs.root)}
+    assert session["budget"]["tokens"] == 100
+    terminal = json.loads((directory / "stdout.jsonl").read_text().splitlines()[-1])
+    assert terminal["budget"]["used_tokens"] == 72
+    blocks = [block for message in observed["calls"][-1]["messages"]
+              for block in message["content"] if block["type"] == "tool_result"]
+    assert [block["tool_use_id"] for block in blocks] == [*manifests, *sources,
+                                                         "escape", "write", "execute"]
+    assert [block["is_error"] for block in blocks] == [False] * 6 + [True] * 3
+    for block, path in zip(blocks[:6], [*manifests, *sources]):
+        assert block["content"] == (inputs.root / path).read_text().rstrip("\n")
+    assert "outside the root" in blocks[-3]["content"]
+    assert all("not allowed" in block["content"] for block in blocks[-2:])
+    assert all(p.read_bytes() == content for p, content in before.items())
+
+
 def test_actual_wave_overlaps_processes_isolates_systems_and_rails(
     capture, tmp_path, installed, monkeypatch
 ):
