+    assert data['tool'] == {'name': 'ruff', 'version': '0.16.10'}
+    assert any(row['code'] == 'F821' and row['message'] == 'Undefined name `undefined_name`'
+               for row in data['diagnostics'])
+    assert entry['source_sha256']['app.py'] == hashlib.sha256(
