 Each writer owns its connection: nothing else is ever pending on it.
 """
+import sqlite3
+import time
 
+ATTEMPTS = 3
 
-def record_event(connection, idempotency_key, payload):
-    connection.execute(
-        "INSERT OR IGNORE INTO events(idempotency_key, payload) VALUES (?, ?)",
-        (idempotency_key, payload),
